@Article{ecg-to-emg,
AUTHOR = {Mendes Junior, José Jair Alves and Campos, Daniel Prado and Biassio, Lorenzo Coelho de Andrade Villela De and Passos, Pedro Carlin and Júnior, Paulo Broniera and Lazzaretti, André Eugênio and Krueger, Eddy},
TITLE = {AD8232 to Biopotentials Sensors: Open Source Project and Benchmark},
