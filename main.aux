\@writefile{lof}{\select@language{magyar} \contentsline {figure}{\numberline {2.}{\ignorespaces "You control water. See how different droplets appear as you change the focus level of your brain. The clearer the mind, the larger the drops and the quicker the bowl gets filled. See how quickly can you complete this task using only the power of your mind?".}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:crystal-clear}{{2}{8}{"You control water. See how different droplets appear as you change the focus level of your brain. The clearer the mind, the larger the drops and the quicker the bowl gets filled. See how quickly can you complete this task using only the power of your mind?"}{figure.caption.5}{}}
\@writefile{lof}{\select@language{magyar} \contentsline {figure}{\numberline {3.}{\ignorespaces "This game will teach you how to get rid of irritating thoughts, concentrate and focus on what's important now. In order to win, you must repress unnecessary thoughts and emotions (I will show you how). Focus on sensing the here and now. Unlock natural resources in your body to fight fatigue and find energy to do the things you love…"}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:energy-booster}{{3}{8}{"This game will teach you how to get rid of irritating thoughts, concentrate and focus on what's important now. In order to win, you must repress unnecessary thoughts and emotions (I will show you how). Focus on sensing the here and now. Unlock natural resources in your body to fight fatigue and find energy to do the things you love…"}{figure.caption.6}{}}
\@writefile{lof}{\select@language{magyar} \contentsline {figure}{\numberline {4.}{\ignorespaces "This simple game will train your mind with a powerful technique which will provide instant relaxation. It works is by harmonizing your breathing with your heart rate (HRV). Clear instructions are attached. Even a child can do it! Let this machine work on your mind for one evening… I can guarantee that your friends will gossip about the "Mental Magic" abilities you will be able to show off the next morning."}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:instant-relaxation}{{4}{9}{"This simple game will train your mind with a powerful technique which will provide instant relaxation. It works is by harmonizing your breathing with your heart rate (HRV). Clear instructions are attached. Even a child can do it! Let this machine work on your mind for one evening… I can guarantee that your friends will gossip about the "Mental Magic" abilities you will be able to show off the next morning."}{figure.caption.7}{}}
\@writefile{lof}{\select@language{magyar} \contentsline {figure}{\numberline {5.}{\ignorespaces "This game teaches you to control your emotions. In order to complete the task, you must silence your thoughts and emotions. The poorer your mental condition, the harder the game will be to play. The car will move slower and potholes will appear in the road. The better your focus and relaxation, the easier the road will become. The car will gain speed. Test yourself against family members and friends! See who will be the first to complete seven laps."}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:mental-magic}{{5}{9}{"This game teaches you to control your emotions. In order to complete the task, you must silence your thoughts and emotions. The poorer your mental condition, the harder the game will be to play. The car will move slower and potholes will appear in the road. The better your focus and relaxation, the easier the road will become. The car will gain speed. Test yourself against family members and friends! See who will be the first to complete seven laps."}{figure.caption.8}{}}
